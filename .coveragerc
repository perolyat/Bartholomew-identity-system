[run]
branch = True
parallel = True
# All first-party runtime packages. Previously only `bartholomew` was measured,
# so identity_interpreter/ and bartholomew_api_bridge_v0_1/ (~5,800 lines of
# runtime code) were invisible to every coverage number the project reported.
source =
    bartholomew
    identity_interpreter
    bartholomew_api_bridge_v0_1
omit =
    */__init__.py
    */__main__.py
    tests/*
    scripts/*
    */migrations/*
    */generated/*

[report]
show_missing = True
skip_covered = True
fail_under = 70
exclude_lines =
    pragma: no cover
    if TYPE_CHECKING:
    raise NotImplementedError
    if __name__ == "__main__":
